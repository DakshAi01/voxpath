# Copy to backend/.env and fill in. main.py loads this file at startup.

# --- Required ---

# Chat model and the embeddings behind long-term memory.
OPENAI_API_KEY=

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
JWT_SECRET=

# Indian Railways lookups (IRCTC via RapidAPI, host irctc-api2.p.rapidapi.com).
RAPIDAPI_KEY=

# Postgres with the pgvector extension. Holds users, conversation history and
# long-term memory. The server starts without it, but sign-in and memory need it.
# Percent-encode special characters in the password (e.g. @ becomes %40).
DATABASE_URL=postgresql://voxpath:password@localhost:5432/voxpath

# --- Optional (defaults shown) ---

# OPENAI_MODEL=gpt-4o-mini
# Changing the embedding model after first boot means rebuilding the store tables:
# the vector column width is fixed when it is created.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMS=            # only needed for a model services.py doesn't know

# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TOKEN_TTL_HOURS=168
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# Agent context budget.
# MAX_HISTORY_TOKENS=3000
# MAX_TOOL_CHARS=6000

# Memory retrieval tuning.
# MEMORY_MIN_SCORE=0.12
# MEMORY_DEDUPE_SCORE=0.85
# MEMORY_OVERFETCH=3

# NEWS_REFRESH_INTERVAL=300         # seconds between background news crawls
# LOG_LEVEL=INFO
